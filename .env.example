# Copy relevant lines into web/.env.local (frontend) or your process
# manager / Render's dashboard (API) -- never commit the real .env files,
# .gitignore already blocks them.

# --- api/ (FastAPI, deployed on Render) ---
# Comma-separated list of origins allowed to call this API from a browser.
# http://localhost:3000 is always allowed in addition to this, so local
# `npm run dev` + `uvicorn api.main:app` works with no env vars set at all.
# Set this to the real Vercel URL once the frontend is deployed (see
# DEPLOY.md) -- until then, CORS blocks every other origin by design.
ALLOWED_ORIGINS=

# --- web/ (Next.js, deployed on Vercel) ---
# Base URL of the deployed API. Defaults to http://localhost:8000 when
# unset, which is correct for local development against `uvicorn
# api.main:app --reload`. Set this as a Vercel environment variable to the
# real Render URL once the API is deployed (see DEPLOY.md).
NEXT_PUBLIC_API_URL=
